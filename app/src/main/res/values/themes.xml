    <style name="Theme.Zenith" parent="Theme.Zenith.Glass" />

    <style name="Theme.Zenith.Glass" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="colorPrimary">#7C4DFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#3D1A99</item>
        <item name="colorSecondary">#00E5FF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#1A1A3E</item>
