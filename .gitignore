# =============================================================================
# Zenith — Root .gitignore
# Tracks: source code, config files, documentation
# Ignores: build artifacts, secrets, IDE files, OS clutter, generated code
# =============================================================================


# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12


# =============================================================================
# INTERNAL / PRIVATE DOCUMENTATION
# Docs folder is kept internal and not published to the repository.
# =============================================================================
docs/


# =============================================================================
# BACKEND (Node.js / NestJS)
# =============================================================================
backend/node_modules/
backend/dist/
backend/.npm
backend/.eslintcache
backend/*.log
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
backend/pnpm-debug.log*
backend/coverage/


# =============================================================================
# FRONTEND (Flutter / Dart)
# =============================================================================

# Build output
frontend/build/
frontend/coverage/

# Flutter tool & plugin metadata (regenerated by flutter pub get)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/

# Riverpod / build_runner generated files
# (These are generated via: dart run build_runner build -d)
frontend/**/*.g.dart
frontend/**/*.freezed.dart
frontend/**/*.mocks.dart

# IDE
frontend/.idea/
frontend/*.iml
frontend/*.ipr
frontend/*.iws
frontend/.vscode/

# Android build artifacts
frontend/android/.gradle/
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/android/local.properties
frontend/android/key.properties

# iOS build artifacts (macOS only)
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/.last_build_id
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/build/

# macOS build artifacts
frontend/macos/Pods/
frontend/macos/.symlinks/
frontend/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/macos/Flutter/Generated.xcconfig

# Windows build artifacts
frontend/windows/flutter/generated_plugin_registrant.cc
frontend/windows/flutter/generated_plugin_registrant.h
frontend/windows/flutter/generated_plugins.cmake

# Linux build artifacts
frontend/linux/flutter/generated_plugin_registrant.cc
frontend/linux/flutter/generated_plugin_registrant.h
frontend/linux/flutter/generated_plugins.cmake

# Dart coverage & symbols
frontend/app.*.symbols
frontend/app.*.map.json


# =============================================================================
# INFRASTRUCTURE
# =============================================================================
infrastructure/.env
infrastructure/*.env.*


# =============================================================================
# OS & SYSTEM FILES
# =============================================================================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*.swo
~$*

# Windows shortcuts
*.lnk


# =============================================================================
# IDE & EDITOR
# =============================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
.atom/
